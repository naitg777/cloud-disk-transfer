# 复制成 /etc/cloud-disk-transfer.env 后填写，权限 600
# 只列最常用的；完整项见 config.example.py

BOT_TOKEN=123456:ABC-DEF_your_telegram_bot_token
ALLOWED_CHAT=123456789
ARIA2_SECRET=your_aria2_rpc_secret

DOWNLOAD_DIR=/data/tg_downloads
ARIA2_DLDIR=/data/aria2/downloads
GOPEED_DLDIR=/data/gopeed/downloads
RCLONE_CONF=/opt/cloud-disk-transfer/rclone.conf
GOPEED_MAP=/opt/cloud-disk-transfer/logs/gopeed_tasks.json
FAILED_LOG=/opt/cloud-disk-transfer/logs/failed.log

RCLONE_DEST=gdrive:TelegramFiles
ARIA2_DEST=gdrive:Aria2Files

# 夸克（可选）
QUARK_MODE=auto
QUARK_BRIDGE_COOKIE_FILE=/opt/cloud-disk-transfer/quark_bridge.cookie

# PikPak（可选）
PIKPAK_TOKEN_FILE=/opt/cloud-disk-transfer/logs/pikpak_token.json
